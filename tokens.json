  "elevation": {
    "0": { "value": "none" },
    "1": { "value": "0 1px 2px rgba(38,57,73,0.06)" },
    "2": { "value": "0 4px 12px rgba(38,57,73,0.08)" }
  },

  "touch": {
    "min":  { "value": "56px" },
    "cozy": { "value": "64px" },
    "gap":  { "value": "12px" }
