      "okBg":    { "value": "#F7FDF7", "type": "color", "$comment": "Completed list row fill" }
    },
    "tempBadge": {
      "fg":      { "value": "#F5A332", "type": "color", "$comment": "임시 차량 배지 텍스트" },
      "bg":      { "value": "#FFF6EA", "type": "color", "$comment": "임시 차량 배지 배경" }
    }
  },

  "font": {
    "family": { "value": "Pretendard, -apple-system, 'Apple SD Gothic Neo', 'Noto Sans KR', sans-serif" },
    "weight": {
      "regular":  { "value": 400 },
