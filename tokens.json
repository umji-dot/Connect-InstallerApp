{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Connect Installer Design System tokens — derived from the 커넥트 인스톨러.fig Figma source. All values verified against the JSX pseudocode in the Figma virtual filesystem.",

  "color": {
    "primary": {
      "default":  { "value": "#223240", "type": "color", "$comment": "Primary navy, buttons + headings" },
      "hover":    { "value": "#162029", "type": "color" },
      "deep":     { "value": "#1D2A38", "type": "color", "$comment": "Header bar background" }
    },
    "danger":  { "value": "#D72222", "type": "color" },
    "success": { "value": "#62D764", "type": "color" },
    "warning": { "value": "#FFBF00", "type": "color" },
    "info":    { "value": "#1B45D2", "type": "color" },
    "neutral": {
