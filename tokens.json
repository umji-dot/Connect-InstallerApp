      "100": { "value": "#F2F2F3", "type": "color" },
      "200": { "value": "#E6E6E6", "type": "color" },
      "300": { "value": "#E0E0E3", "type": "color", "$comment": "Default border" },
      "400": { "value": "#CECED2", "type": "color", "$comment": "Placeholder text" },
      "500": { "value": "#9797A0", "type": "color" },
      "600": { "value": "#66666F", "type": "color", "$comment": "Form labels, secondary text" },
      "700": { "value": "#484851", "type": "color" },
      "800": { "value": "#223240", "type": "color" },
      "900": { "value": "#000000", "type": "color" }
    },
    "surface": {
