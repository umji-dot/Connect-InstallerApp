      "semibold": { "value": 600 },
      "bold":     { "value": 700 }
    },
    "size": {
      "display":  { "value": "32px" },
      "h1":       { "value": "24px" },
      "h2":       { "value": "22px" },
      "h3":       { "value": "20px" },
      "bodyLg":   { "value": "18px" },
      "body":     { "value": "17px" },
      "bodySm":   { "value": "16px" },
      "caption":  { "value": "15px" },
      "micro":    { "value": "14px" }
    },
    "lineHeight": {
      "tight":  { "value": 1.0 },
      "normal": { "value": 1.5 }
    }
  },

  "space": {
    "1":  { "value": "4px"  },
    "2":  { "value": "8px"  },
    "3":  { "value": "12px" },
    "4":  { "value": "16px" },
